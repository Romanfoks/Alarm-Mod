{
  "multipart": [
    {
      "when": { "facing": "up" },
      "apply": { "model": "alarmmod:block/alarm" }
    },
    {
      "when": { "facing": "down" },
      "apply": { "model": "alarmmod:block/alarm", "x": -180 }
    },
    {
      "when": { "facing": "north" },
      "apply": { "model": "alarmmod:block/alarm", "x": -90, "y": 0 }
    },
    {
      "when": { "facing": "south" },
      "apply": { "model": "alarmmod:block/alarm", "x": -90, "y": -180 }
    },
    {
      "when": { "facing": "west" },
      "apply": { "model": "alarmmod:block/alarm", "x": -90, "y": -270 }
    },
    {
      "when": { "facing": "east" },
      "apply": { "model": "alarmmod:block/alarm", "x": -90, "y": -90 }
    }
  ]
}